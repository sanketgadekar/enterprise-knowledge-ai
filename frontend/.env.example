# Base URL of the FastAPI backend.
# Read by the Next.js SERVER (route handlers) only, which forwards requests to it,
# so the browser never calls the backend directly and CORS is not involved.
# It is not a secret, but it is baked in at build time: restart `npm run dev` or
# re-run `npm run build` after changing it.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
