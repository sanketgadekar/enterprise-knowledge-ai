# Deployment
DEPLOYMENT_MODE=local

# LLM Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Vector DB
VECTOR_DB=faiss

# Embeddings
# Set this to the embedding model expected by your configured embedding provider.
EMBEDDING_MODEL=local

# Memory
MEMORY_BACKEND=local
MEMORY_RETENTION_DAYS=30

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Database
DATABASE_URL=postgresql+asyncpg://postgres:your_database_password@localhost:5432/enterprise_ai
DATABASE_ECHO=false

# Security
JWT_SECRET_KEY=replace_with_a_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
