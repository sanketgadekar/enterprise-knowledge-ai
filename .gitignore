```gitignore
# =============================
# Python
# =============================
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
backend/venv/

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
backend/logs/

# Alembic
**/alembic/versions/__pycache__/

# Local database files
*.sqlite3
*.db

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db

# Testing
.coverage
htmlcov/
.pytest_cache/

# MyPy / type checking
.mypy_cache/

# Build and distribution
build/
dist/
*.egg-info/

# Docker / process files
*.pid

# Uploaded documents and generated vector data
backend/storage/files/*
backend/storage/vector/*

# Keep storage directories in Git
!backend/storage/files/.gitkeep
!backend/storage/vector/.gitkeep

# Frontend dependencies and build
frontend/node_modules/
frontend/dist/
